# Copy to .env.local (git-ignored) and fill in. Never commit the real key.

# --- NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Different models per job (defaults in agent/llm.py ROUTES; check exact ids with: .venv/bin/python scripts/tf_models.py)
# LLM_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL          reads the customer's payment screenshot (never falls back to LLM_MODEL)
# LLM_MODEL_INTAKE=nvidia/Nemotron-3_5-Lightning          reads the message + plans the lookups
# LLM_MODEL_ESCALATE=nvidia/Nemotron-3-Ultra-550b-a55b    re-reads only when code finds the first reading unsure (LLM_ESCALATE=0 turns it off)
# LLM_MODEL_EXPLAIN=nvidia/nemotron-3-super-120b-a12b     cited explanation + reply draft
# LLM_MODEL_REPLY=nvidia/nemotron-3-super-120b-a12b       reply when a screenshot's payment is not in the ledger
# LLM_MODEL=                one text model for every text role (overrides the text defaults above)
# LLM_VISION_JSON=json_schema   json_schema | json_object | off  (structured output for the vision call; falls back once on 400)
# PROOF_UTC_OFFSET_MIN=540      screenshots show local time (KST/JST = UTC+9)
# PROOF_TIME_TOLERANCE_MIN=10
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# LLM_TIMEOUT=60

# --- public demo (Cloud Run sets these) ---
# DEMO_PUBLIC=1
# DEMO_LIVE_PER_IP_HOUR=8
# DEMO_LIVE_PER_DAY=300
# DEMO_SANDBOX_TTL=1800
# AGENT_LOOP=0            # public demo: the model's plan only (two model calls per run)

# --- dry run without a key: scripted stand-in, labelled FAKE everywhere, refused in public mode ---
# LLM_FAKE=1

# --- optional: the older local setup from the Open Agent Hackathon (see docs/open-agent-2026-10-25/) ---
# NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# ZETARIS_JDBC_JAR=
